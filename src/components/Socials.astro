---
import config from "@/config";
import LinkButton from "./LinkButton.astro";
import { getAssetPath } from "@/utils/withBase";

const { site, socials } = config;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

// 点击后弹二维码而非跳转的社交项（qr 指向 public/ 下的图片）
const QR_SOCIALS: Record<string, { qr: string; label: string }> = {
  douyin: { qr: "/qr/douyin.jpg", label: "抖音" },
  wechat: { qr: "/qr/wechat.jpg", label: "微信" },
};

const items = await Promise.all(
  socials.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const qr = QR_SOCIALS[name];
    const title =
      linkTitle ??
      (url.startsWith("mailto:") || name === "mail"
        ? `Send an email to ${site.title}`
        : `${site.title} on ${name.charAt(0).toUpperCase() + name.slice(1)}`);
    return {
      url,
      title,
      Icon,
      name,
      qr: qr ? getAssetPath(qr.qr.replace(/^\//, "")) : null,
      qrLabel: qr?.label ?? name,
    };
  })
);
---

<div class="flex flex-wrap items-center gap-1">
  {
    items.map(({ url, title, Icon, name, qr, qrLabel }) =>
      Icon ? (
        qr ? (
          <button
            type="button"
            data-qr-open={`qr-dialog-${name}`}
            class="group hover:text-accent p-2 sm:p-1"
            title={`扫码加我${qrLabel}`}
            aria-label={`扫码加我${qrLabel}`}
          >
            <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
            <span class="sr-only">扫码加我{qrLabel}</span>
          </button>
        ) : (
          <LinkButton href={url} class="p-2 hover:rotate-6 sm:p-1" title={title}>
            <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
            <span class="sr-only">{title}</span>
          </LinkButton>
        )
      ) : null
    )
  }
</div>

{
  items
    .filter(item => item.qr)
    .map(({ name, qr, qrLabel, title }) => (
      <dialog
        id={`qr-dialog-${name}`}
        class="bg-card text-foreground open:animate-in m-auto w-[90vw] max-w-sm rounded-xl p-0 shadow-xl backdrop:bg-black/50"
        aria-label={title}
      >
        <div class="p-6 text-center">
          <div class="flex items-start justify-between text-left">
            <h4 class="font-semibold">扫码加我{qrLabel}</h4>
            <button
              data-qr-close
              class="text-muted-foreground hover:text-foreground ml-4 text-xl leading-none"
              aria-label="关闭"
            >
              ×
            </button>
          </div>
          <img
            src={qr}
            alt={`${qrLabel}二维码`}
            class="mx-auto mt-4 w-56 rounded border bg-white p-2"
            loading="lazy"
          />
        </div>
      </dialog>
    ))
}

<script>
  function bindQrDialogs() {
    document.querySelectorAll<HTMLElement>("[data-qr-open]").forEach(btn => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "1";
      const dialog = document.getElementById(btn.dataset.qrOpen ?? "");
      btn.addEventListener("click", () => {
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    });
    document.querySelectorAll<HTMLElement>("[data-qr-close]").forEach(btn => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        const dialog = btn.closest("dialog");
        if (dialog instanceof HTMLDialogElement) dialog.close();
      });
    });
  }
  bindQrDialogs();
  document.addEventListener("astro:page-load", bindQrDialogs);
</script>
